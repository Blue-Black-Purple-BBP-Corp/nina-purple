{
  "name": "Photo",
  "type": "object",
  "properties": {
    "photo_id": {
      "type": "string",
      "description": "Stable photo identifier (ULID)."
    },
    "owner_native_user_id": {
      "type": "string",
      "description": "Platform user ID of the photo owner."
    },
    "owner_bbp_member_id": {
      "type": "string",
      "description": "BBP member ID of the owner, when available."
    },
    "storage_uri": {
      "type": "string",
      "description": "Private storage URI (from UploadPrivateFile). Never exposed to non-owner clients; rendered only via short-lived signed URLs from getPhotoAccess."
    },
    "legacy_public_url": {
      "type": "string",
      "description": "Original public CDN URL from the pre-migration UserProfile.photos[] array. Kept as a migration reference/rollback pointer only. Not used for delivery after migration."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "removed",
        "rejected"
      ],
      "default": "active",
      "description": "active = deliverable to entitled viewers; under_review = pending moderation; removed = owner/moderator removed (not delivered); rejected = moderation denied."
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the owner's main profile photo (first in order)."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order within the owner's photo set (0 = first)."
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Original upload timestamp. For migrated photos, the UserProfile.created_date is used to preserve history."
    },
    "removed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the photo was removed/rejected. Null while active."
    },
    "migration_source": {
      "type": "string",
      "enum": [
        "upload",
        "batch_migration"
      ],
      "default": "upload",
      "description": "How the Photo record was created: upload = new private-storage upload; batch_migration = migrated from legacy UserProfile.photos[]."
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the batch migration created this record. Null for direct uploads."
    }
  },
  "required": [
    "photo_id",
    "owner_native_user_id",
    "storage_uri",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}