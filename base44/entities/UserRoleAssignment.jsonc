{
  "name": "UserRoleAssignment",
  "type": "object",
  "properties": {
    "role_assignment_id": {
      "type": "string",
      "description": "Stable assignment identifier."
    },
    "native_user_id": {
      "type": "string",
      "description": "Platform user ID of the staff member receiving the role."
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "trust_safety",
        "rewards_finance",
        "engineering_operations",
        "super_admin"
      ],
      "description": "Staff role label. Determines which operating contexts this assignment authorizes."
    },
    "scope": {
      "type": "string",
      "description": "Operating context this assignment grants, or 'all' for super_admin. One of: admin, trust_safety, rewards_finance, engineering_operations, all."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "granted_by": {
      "type": "string",
      "description": "Platform user ID of the admin who granted the role."
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry. Null = no expiry."
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by": {
      "type": "string"
    },
    "revocation_reason": {
      "type": "string"
    }
  },
  "required": [
    "native_user_id",
    "role",
    "scope"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}