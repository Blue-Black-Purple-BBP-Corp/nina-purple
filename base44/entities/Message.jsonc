{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "default": 0
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "system",
        "nina_suggestion"
      ],
      "default": "text"
    }
  },
  "required": [
    "conversation_id",
    "from_user_id",
    "to_user_id",
    "content"
  ]
}