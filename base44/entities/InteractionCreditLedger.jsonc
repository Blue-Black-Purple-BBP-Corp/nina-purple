{
  "name": "InteractionCreditLedger",
  "type": "object",
  "description": "Append-only BBP Credit ledger. The authoritative source of truth for a member's prepaid BBP Credit wallet (1 BBP = $1 toward eligible Nina Purple purchases). UserProfile.credit_balance is a denormalized cache updated atomically with each ledger entry; the ledger itself is the source of truth and the audit record. BBP Credits can NEVER pay for Nina Purple Membership.",
  "properties": {
    "ledger_id": {
      "type": "string",
      "description": "Stable ledger entry identifier (ULID)."
    },
    "native_user_id": {
      "type": "string",
      "description": "Platform user ID of the wallet owner (RLS key)."
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "credit_purchase",
        "debit_unlock",
        "debit_outreach",
        "debit_reveal",
        "hold",
        "release",
        "reversal",
        "staff_adjustment",
        "expiry"
      ],
      "description": "credit_purchase = Stripe top-up; debit_unlock = profile unlock (messaging); debit_outreach = initial paid message; debit_reveal = photo reveal (owner-approved); hold = reserved for pending photo-reveal request (not yet debited); release = hold released (decline/expiry/cancel); reversal = refund/chargeback/staff reversal; staff_adjustment = manual; expiry = expired credit."
    },
    "amount_delta": {
      "type": "number",
      "description": "Positive for credits, negative for debits/holds. In USD (= BBP Credits). Holds are negative and status='pending'; they reduce available balance but not total balance."
    },
    "balance_after": {
      "type": "number",
      "description": "Total balance immediately after this entry applied (sum of completed entries). Audit snapshot; available balance = total - reserved holds."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "stripe_topup",
        "unlock",
        "outreach",
        "reveal",
        "photo_reveal_hold",
        "photo_reveal_release",
        "refund_reversal",
        "staff_adjustment",
        "expiry"
      ]
    },
    "source_reference": {
      "type": "string",
      "description": "Stripe charge/checkout ID, Connection ID, Message ID, PhotoRevealRequest ID, or reservation ID that gave rise to this entry."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique per logical operation per user. Prevents duplicate debits/credits/holds on retry, refresh, double-click, or webhook redelivery."
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "reversed",
        "expired",
        "failed"
      ],
      "default": "completed",
      "description": "pending = hold reserved (not yet debited); expired = hold released without debit; completed = finalized; reversed = compensating entry applied."
    },
    "reservation_id": {
      "type": "string",
      "description": "For hold/release entries: the reservation identifier linking a hold to its release or conversion. Null for non-hold entries."
    },
    "reserved_for_type": {
      "type": "string",
      "enum": [
        "photo_reveal"
      ],
      "description": "What the hold is reserved for. photo_reveal = pending owner-approval photo reveal request."
    },
    "reserved_for_id": {
      "type": "string",
      "description": "The PhotoRevealRequest ID this hold is reserved for."
    },
    "hold_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the hold auto-releases if not converted or explicitly released. For photo reveals = request expiry (7 days)."
    },
    "description_member_safe": {
      "type": "string",
      "description": "Neutral, member-facing description of the entry."
    },
    "staff_reason": {
      "type": "string",
      "description": "Reason recorded by staff for adjustments/reversals. Null for member-initiated entries."
    },
    "correlation_id": {
      "type": "string",
      "description": "Correlates a debit with its reversal, a top-up with its Stripe event, or a hold with its release/conversion."
    }
  },
  "required": [
    "ledger_id",
    "native_user_id",
    "entry_type",
    "amount_delta",
    "source_type",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}