{
  "name": "BBPWalletBalance",
  "type": "object",
  "properties": {
    "bbp_member_id": {
      "type": "string"
    },
    "native_user_id": {
      "type": "string",
      "description": "Platform user ID for RLS."
    },
    "available_points": {
      "type": "number",
      "default": 0
    },
    "pending_points": {
      "type": "number",
      "default": 0
    },
    "expired_points": {
      "type": "number",
      "default": 0,
      "description": "Lifetime points expired, accumulated from expiry ledger entries."
    },
    "lifetime_earned": {
      "type": "number",
      "default": 0
    },
    "lifetime_redeemed": {
      "type": "number",
      "default": 0
    },
    "lifetime_reversed": {
      "type": "number",
      "default": 0,
      "description": "Lifetime points reversed via compensating ledger entries."
    },
    "face_value_available_usd": {
      "type": "number",
      "default": 0,
      "description": "Always equals available_points because 1 BBP = $1."
    },
    "face_value_pending_usd": {
      "type": "number",
      "default": 0,
      "description": "Always equals pending_points because 1 BBP = $1."
    }
  },
  "required": [
    "bbp_member_id",
    "native_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}