{
  "name": "BBPPointsLedger",
  "type": "object",
  "properties": {
    "ledger_id": {
      "type": "string",
      "description": "ULID-formatted ledger entry ID."
    },
    "bbp_member_id": {
      "type": "string"
    },
    "native_user_id": {
      "type": "string",
      "description": "Platform user ID for RLS (never used for reward eligibility)."
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "award",
        "reversal",
        "redemption",
        "adjustment",
        "expiry"
      ]
    },
    "points_delta": {
      "type": "number",
      "description": "Positive for awards, negative for reversals/redemptions/expiry."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "redeemed",
        "reversed",
        "expired",
        "held",
        "under_review"
      ],
      "default": "available"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "profile_complete",
        "orientation_complete",
        "account_confirmation",
        "meetup_confirmation",
        "referral_qualified",
        "event_attendance",
        "experience_attendance",
        "profile_refresh",
        "community_contribution",
        "social_proof",
        "redemption",
        "staff_adjustment",
        "expiry"
      ]
    },
    "source_event_id": {
      "type": "string",
      "description": "Unique event reference for idempotency."
    },
    "rule_id": {
      "type": "string",
      "description": "The RewardRule rule_id that governed this award."
    },
    "rule_version": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "description": "When pending points become available."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When available points expire (12 months after available_at)."
    },
    "reversal_of_ledger_id": {
      "type": "string",
      "description": "Links a reversal entry to the original award entry."
    },
    "staff_reason": {
      "type": "string",
      "description": "Reason recorded by staff for adjustments, holds, or reversals."
    },
    "member_safe_description": {
      "type": "string",
      "description": "Neutral, non-accusatory description shown to the member for pending/denied status."
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "bbp_member_id",
    "native_user_id",
    "entry_type",
    "points_delta",
    "source_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}