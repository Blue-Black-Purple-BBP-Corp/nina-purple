{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "age": {
      "type": "number"
    },
    "zodiac": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "sexual_orientation": {
      "type": "string"
    },
    "gender_pronoun": {
      "type": "string"
    },
    "relationship_status": {
      "type": "string"
    },
    "dating_archetype": {
      "type": "string",
      "enum": [
        "blue",
        "black",
        "purple"
      ]
    },
    "bio": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos_private": {
      "type": "boolean",
      "default": true
    },
    "show_in_listings": {
      "type": "boolean",
      "default": true
    },
    "allow_messages_all": {
      "type": "boolean",
      "default": true
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "solar",
        "lunar",
        "stellar",
        "galactic"
      ],
      "default": "solar"
    },
    "credit_balance": {
      "type": "number",
      "default": 0
    },
    "bbp_rewards": {
      "type": "number",
      "default": 0
    },
    "consecutive_no_match_months": {
      "type": "number",
      "default": 0
    },
    "last_bbp_conversion_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "guidelines_accepted": {
      "type": "boolean",
      "default": false
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "individual",
        "couple"
      ],
      "default": "individual"
    },
    "paired_status": {
      "type": "string",
      "enum": [
        "single",
        "pending",
        "paired"
      ],
      "default": "single"
    },
    "partner_email": {
      "type": "string"
    },
    "partner_user_id": {
      "type": "string"
    },
    "couple_consent_given": {
      "type": "boolean",
      "default": false
    },
    "attachment_style": {
      "type": "string",
      "enum": [
        "secure",
        "anxious",
        "avoidant",
        "fearful"
      ]
    },
    "attachment_anxiety": {
      "type": "number"
    },
    "attachment_avoidance": {
      "type": "number"
    },
    "big5_openness": {
      "type": "number"
    },
    "big5_conscientiousness": {
      "type": "number"
    },
    "big5_extraversion": {
      "type": "number"
    },
    "big5_agreeableness": {
      "type": "number"
    },
    "big5_neuroticism": {
      "type": "number"
    },
    "is_ambassador": {
      "type": "boolean",
      "default": false
    },
    "ambassador_signup_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_profile_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "user_id",
    "display_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}