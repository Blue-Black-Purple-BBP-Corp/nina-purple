{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "age": {
      "type": "number"
    },
    "zodiac": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "sexual_orientation": {
      "type": "string"
    },
    "gender_pronoun": {
      "type": "string"
    },
    "relationship_status": {
      "type": "string"
    },
    "dating_archetype": {
      "type": "string",
      "enum": [
        "blue",
        "black",
        "purple"
      ]
    },
    "bio": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos_private": {
      "type": "boolean",
      "default": true
    },
    "show_in_listings": {
      "type": "boolean",
      "default": true
    },
    "allow_messages_all": {
      "type": "boolean",
      "default": true
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "solar",
        "lunar",
        "stellar",
        "galactic",
        "nina_membership"
      ],
      "default": "solar"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "billing_exempt",
        "lapsed"
      ],
      "default": "none",
      "description": "Authoritative membership state. active = paying $20/mo, billing_exempt = special code reward active, lapsed = cancelled/expired, none = never subscribed."
    },
    "subscription_renewal_date": {
      "type": "string",
      "format": "date-time",
      "description": "Individual billing renewal date. Usage counters reset on this date, not calendar month start."
    },
    "billing_exempt_until": {
      "type": "string",
      "format": "date-time",
      "description": "Until this date, the $20/mo charge is skipped but all entitlements remain active. Set by special code redemption."
    },
    "free_profile_unlocks_used": {
      "type": "number",
      "default": 0,
      "description": "Counter for free profile unlocks used in the current billing cycle. Resets to 0 on subscription_renewal_date."
    },
    "free_messages_used": {
      "type": "number",
      "default": 0,
      "description": "Counter for free messages used in the current billing cycle. Resets to 0 on subscription_renewal_date. Excludes messages in the user's own rooms."
    },
    "signup_sequence_number": {
      "type": "number",
      "description": "Global signup order. First 200 users who complete signup after the Special Code feature ships are eligible for a code."
    },
    "is_founding_member": {
      "type": "boolean",
      "default": false,
      "description": "Granted by the grantFoundingMembers admin function. Permanent once granted; independent of subscription state or cutoff changes."
    },
    "founding_member_since": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the Founding Member grant was applied. Null until granted."
    },
    "credit_balance": {
      "type": "number",
      "default": 0
    },
    "bbp_rewards": {
      "type": "number",
      "default": 0
    },
    "consecutive_no_match_months": {
      "type": "number",
      "default": 0
    },
    "last_bbp_conversion_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "complete"
      ],
      "default": "not_started"
    },
    "onboarding_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarding_version": {
      "type": "string"
    },
    "onboarding_step": {
      "type": "string",
      "description": "Last onboarding step reached, for resume functionality."
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "guidelines_accepted": {
      "type": "boolean",
      "default": false
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "individual",
        "couple"
      ],
      "default": "individual",
      "description": "Experience mode. individual = singles matching pool; couple = partner-linked, excluded from singles pool."
    },
    "paired_status": {
      "type": "string",
      "enum": [
        "single",
        "pending",
        "paired"
      ],
      "default": "single"
    },
    "partner_email": {
      "type": "string"
    },
    "partner_user_id": {
      "type": "string"
    },
    "couple_consent_given": {
      "type": "boolean",
      "default": false
    },
    "attachment_style": {
      "type": "string",
      "enum": [
        "secure",
        "anxious",
        "avoidant",
        "fearful"
      ]
    },
    "attachment_anxiety": {
      "type": "number"
    },
    "attachment_avoidance": {
      "type": "number"
    },
    "big5_openness": {
      "type": "number"
    },
    "big5_conscientiousness": {
      "type": "number"
    },
    "big5_extraversion": {
      "type": "number"
    },
    "big5_agreeableness": {
      "type": "number"
    },
    "big5_neuroticism": {
      "type": "number"
    },
    "is_ambassador": {
      "type": "boolean",
      "default": false
    },
    "ambassador_signup_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_profile_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "limited_review",
        "suspended",
        "permanently_removed"
      ],
      "default": "active",
      "description": "Server-enforced account-status guard. suspended = removed from discovery/matching, messaging and new bookings blocked, BBP frozen; login permitted so the member can view the notice and appeal. Enforced across profiles, connections, chat, events, experiences, BBP and redemption through a single guard."
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspension_reason_code": {
      "type": "string",
      "description": "Stable code for the suspension reason."
    },
    "suspension_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time-bound suspension. Null = active-review state pending staff decision."
    },
    "review_owner": {
      "type": "string",
      "description": "Admin user ID overseeing the case and reinstatement decision."
    },
    "appeal_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "denied"
      ],
      "default": "none"
    },
    "auth_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "password",
          "google",
          "microsoft",
          "apple"
        ]
      },
      "default": [],
      "description": "Self-declared record of the sign-in methods the member has authenticated with, captured at login. Used by the privileged-mode step-up flow to show only methods the member has actually used. NOT platform-verified: Base44 does not expose linked identities, so this is a best-effort approximation. Passkey/passwordless methods are not representable here because the platform does not support them."
    }
  },
  "required": [
    "user_id",
    "display_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}