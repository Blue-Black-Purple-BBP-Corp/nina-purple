{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "age": {
      "type": "number"
    },
    "zodiac": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "sexual_orientation": {
      "type": "string"
    },
    "gender_pronoun": {
      "type": "string"
    },
    "relationship_status": {
      "type": "string"
    },
    "dating_archetype": {
      "type": "string",
      "enum": [
        "blue",
        "black",
        "purple"
      ]
    },
    "bio": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos_private": {
      "type": "boolean",
      "default": true
    },
    "show_in_listings": {
      "type": "boolean",
      "default": true
    },
    "allow_messages_all": {
      "type": "boolean",
      "default": true
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "solar",
        "lunar",
        "stellar",
        "galactic",
        "nina_membership"
      ],
      "default": "solar"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "billing_exempt",
        "lapsed"
      ],
      "default": "none",
      "description": "Authoritative membership state. active = paying $20/mo, billing_exempt = special code reward active, lapsed = cancelled/expired, none = never subscribed."
    },
    "subscription_renewal_date": {
      "type": "string",
      "format": "date-time",
      "description": "Individual billing renewal date. Usage counters reset on this date, not calendar month start."
    },
    "billing_exempt_until": {
      "type": "string",
      "format": "date-time",
      "description": "Until this date, the $20/mo charge is skipped but all entitlements remain active. Set by special code redemption or legacy founding-member admin grant."
    },
    "free_profile_unlocks_used": {
      "type": "number",
      "default": 0
    },
    "free_messages_used": {
      "type": "number",
      "default": 0
    },
    "signup_sequence_number": {
      "type": "number"
    },
    "is_founding_member": {
      "type": "boolean",
      "default": false,
      "description": "Granted by the grantFoundingMembers admin function. Permanent once granted; independent of subscription state or cutoff changes. Drives FoundingMemberBenefit eligibility."
    },
    "founding_member_since": {
      "type": "string",
      "format": "date-time"
    },
    "credit_balance": {
      "type": "number",
      "default": 0
    },
    "bbp_rewards": {
      "type": "number",
      "default": 0
    },
    "consecutive_no_match_months": {
      "type": "number",
      "default": 0
    },
    "last_bbp_conversion_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "awaiting_membership",
        "complete"
      ],
      "default": "not_started",
      "description": "awaiting_membership = profile + compatibility complete but membership selection pending; restored to the membership step on re-entry."
    },
    "onboarding_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarding_version": {
      "type": "string"
    },
    "onboarding_step": {
      "type": "string",
      "description": "Last granular onboarding step reached (UI step name), for resume functionality."
    },
    "onboarding_current_step": {
      "type": "string",
      "description": "Coarse stable step identifier (age_eligibility | profile_basics | profile_media | compatibility | membership | completion). Survives UI reordering; used by route guards to restore the latest incomplete step."
    },
    "onboarding_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "age_confirmation_status": {
      "type": "string",
      "enum": [
        "confirmed"
      ],
      "description": "Set once the member confirms 18+ eligibility for the current onboarding version. When set, the age step is never re-asked on back/refresh/re-entry."
    },
    "age_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "membership_selection_status": {
      "type": "string",
      "enum": [
        "pending",
        "trial_started",
        "standard_started",
        "active"
      ],
      "description": "Tracks membership selection at the membership step. pending = at step; trial_started = founding trial checkout initiated; standard_started = standard checkout initiated; active = membership active."
    },
    "membership_subscription_reference": {
      "type": "string",
      "description": "Stripe subscription/checkout reference for the membership selected at onboarding."
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "guidelines_accepted": {
      "type": "boolean",
      "default": false
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "individual",
        "couple"
      ],
      "default": "individual",
      "description": "Experience mode. individual = singles matching pool; couple = partner-linked, excluded from singles pool."
    },
    "paired_status": {
      "type": "string",
      "enum": [
        "single",
        "pending",
        "paired"
      ],
      "default": "single"
    },
    "partner_email": {
      "type": "string"
    },
    "partner_user_id": {
      "type": "string"
    },
    "couple_consent_given": {
      "type": "boolean",
      "default": false
    },
    "attachment_style": {
      "type": "string",
      "enum": [
        "secure",
        "anxious",
        "avoidant",
        "fearful"
      ]
    },
    "attachment_anxiety": {
      "type": "number"
    },
    "attachment_avoidance": {
      "type": "number"
    },
    "big5_openness": {
      "type": "number"
    },
    "big5_conscientiousness": {
      "type": "number"
    },
    "big5_extraversion": {
      "type": "number"
    },
    "big5_agreeableness": {
      "type": "number"
    },
    "big5_neuroticism": {
      "type": "number"
    },
    "is_ambassador": {
      "type": "boolean",
      "default": false
    },
    "ambassador_signup_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_profile_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "limited_review",
        "suspended",
        "permanently_removed"
      ],
      "default": "active",
      "description": "Server-enforced account-status guard. suspended = removed from discovery/matching, messaging and new bookings blocked, BBP frozen; login permitted so the member can view the notice and appeal."
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspension_reason_code": {
      "type": "string"
    },
    "suspension_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_owner": {
      "type": "string"
    },
    "appeal_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "denied"
      ],
      "default": "none"
    },
    "auth_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "password",
          "google",
          "microsoft",
          "apple"
        ]
      },
      "default": [],
      "description": "Self-declared record of the sign-in methods the member has authenticated with. Best-effort; Base44 does not expose linked identities."
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by_code": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "display_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}