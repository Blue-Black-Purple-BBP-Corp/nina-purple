{
  "name": "CompatibilityRevision",
  "type": "object",
  "properties": {
    "revision_id": {
      "type": "string",
      "description": "Stable revision identifier (ULID)."
    },
    "native_user_id": {
      "type": "string",
      "description": "Platform user ID of the member who submitted the revision (RLS key)."
    },
    "compatibility_version": {
      "type": "number",
      "description": "The version number assigned to this submission."
    },
    "revised_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "onboarding",
        "member_edit",
        "staff_edit"
      ],
      "default": "member_edit"
    },
    "attachment_style": {
      "type": "string",
      "enum": [
        "secure",
        "anxious",
        "avoidant",
        "fearful"
      ]
    },
    "attachment_anxiety": {
      "type": "number"
    },
    "attachment_avoidance": {
      "type": "number"
    },
    "big5_openness": {
      "type": "number"
    },
    "big5_conscientiousness": {
      "type": "number"
    },
    "big5_extraversion": {
      "type": "number"
    },
    "big5_agreeableness": {
      "type": "number"
    },
    "big5_neuroticism": {
      "type": "number"
    },
    "answers_snapshot": {
      "type": "string",
      "description": "JSON-encoded snapshot of the 21 onboarding answers at this revision. Restricted \u2014 never exposed to other members, standard support, moderation, rewards, or admins in Member mode."
    },
    "edit_reason": {
      "type": "string",
      "description": "Member-safe reason/note for the revision, if provided."
    }
  },
  "required": [
    "revision_id",
    "native_user_id",
    "compatibility_version",
    "source"
  ],
  "rls": {
    "create": {
      "data.native_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.native_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}