{
  "name": "StaffAuditLog",
  "type": "object",
  "properties": {
    "staff_user_id": {
      "type": "string",
      "description": "Platform user ID of the staff member who performed the action."
    },
    "action": {
      "type": "string",
      "enum": [
        "rule_edit",
        "catalog_edit",
        "hold",
        "release",
        "reversal",
        "adjustment",
        "budget_override"
      ]
    },
    "target_type": {
      "type": "string",
      "description": "Entity type of the target (e.g. RewardRule, BBPPointsLedger, RedemptionCatalog)."
    },
    "target_id": {
      "type": "string",
      "description": "ID of the target record."
    },
    "prior_state": {
      "type": "string",
      "description": "JSON-encoded snapshot of the record before the change."
    },
    "new_state": {
      "type": "string",
      "description": "JSON-encoded snapshot of the record after the change."
    },
    "reason": {
      "type": "string",
      "description": "Staff-provided reason for the action."
    }
  },
  "required": [
    "staff_user_id",
    "action",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}