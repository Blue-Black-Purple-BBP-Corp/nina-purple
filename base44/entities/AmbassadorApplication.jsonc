{
  "name": "AmbassadorApplication",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "interview_scheduled",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "pending"
    },
    "motivation": {
      "type": "string",
      "maxLength": 2000
    },
    "relevant_experience": {
      "type": "string",
      "maxLength": 2000
    },
    "availability_hours_week": {
      "type": "number"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community_involvement": {
      "type": "string",
      "maxLength": 1000
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "interview_type": {
      "type": "string",
      "enum": [
        "video",
        "phone"
      ]
    },
    "interview_scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "interview_link": {
      "type": "string"
    },
    "interview_notes": {
      "type": "string",
      "maxLength": 2000
    },
    "admin_notes": {
      "type": "string",
      "maxLength": 2000
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "motivation"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}