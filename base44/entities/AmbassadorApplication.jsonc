{
  "name": "AmbassadorApplication",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "motivation": {
      "type": "string",
      "maxLength": 2000
    },
    "weekly_availability": {
      "type": "string"
    },
    "social_presence": {
      "type": "string"
    },
    "references": {
      "type": "string",
      "maxLength": 1000
    },
    "preferred_interview": {
      "type": "string",
      "enum": [
        "video",
        "phone"
      ],
      "default": "video"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_review",
        "interview_scheduled",
        "approved",
        "declined"
      ],
      "default": "submitted"
    },
    "admin_notes": {
      "type": "string"
    },
    "interview_type": {
      "type": "string",
      "enum": [
        "video",
        "phone"
      ]
    },
    "interview_date": {
      "type": "string",
      "format": "date-time"
    },
    "interview_link": {
      "type": "string"
    },
    "interview_phone": {
      "type": "string"
    },
    "interview_notes": {
      "type": "string"
    },
    "decision_feedback": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "decision_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "motivation"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}