{
  "name": "Connection",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "compatibility_score": {
      "type": "number"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_unlocked": {
      "type": "boolean",
      "default": false,
      "description": "True only when BOTH parties have completed their unlock payment. Set by the shared completion logic, never directly by the client."
    },
    "unlock_cost_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount from_user paid (0 for free unlocks). Recorded at unlockConnection time."
    },
    "from_unlock_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether from_user has paid their share of the mutual unlock cost. Set by unlockConnection; required for the connection to complete."
    },
    "to_unlock_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether to_user has paid their share of the mutual unlock cost. Set by acceptConnection; required for the connection to complete."
    },
    "pending_payment_for": {
      "type": "string",
      "enum": [
        "from_user",
        "to_user"
      ],
      "description": "When status is 'pending_payment', indicates which party still needs to complete their payment. Null when not in pending_payment state."
    },
    "gallery_unlocked": {
      "type": "boolean",
      "default": false
    },
    "photos_shared": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "declined",
        "blocked",
        "pending_payment"
      ],
      "default": "pending",
      "description": "pending = initial match; pending_payment = one party approved but the other lacks credits; connected = both parties paid and the connection is active; declined/blocked = rejected."
    },
    "messages_count": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "from_user_id",
    "to_user_id"
  ],
  "rls": {
    "create": {
      "data.from_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        }
      ]
    }
  }
}